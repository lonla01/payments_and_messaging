# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Ne jamais committer le fichier ".env" (deja ignore par .gitignore).

# --- Serveur ---
PORT=4000
# URL publique du backend (utilisee pour construire notify_url/return_url/statusCallback).
# En local avec un tunnel (ngrok, cloudflared...), mettre l'URL du tunnel ici.
PUBLIC_BASE_URL=http://localhost:4000
# URL du frontend (utilisee pour construire le return_url CinetPay)
FRONTEND_BASE_URL=http://localhost:5173

# --- CinetPay ---
# https://app.cinetpay.com > Compte > API
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Cle secrete (differente de l'API key) utilisee pour verifier le x-token HMAC des webhooks
CINETPAY_SECRET_KEY=
# Optionnel : par defaut construits a partir de PUBLIC_BASE_URL / FRONTEND_BASE_URL
CINETPAY_NOTIFY_URL=
CINETPAY_RETURN_URL=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
# Cle API restreinte (Console Twilio > Keys & Credentials > API keys), PAS l'Auth Token principal
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Auth Token principal : utilise UNIQUEMENT pour verifier la signature des webhooks entrants
# (X-Twilio-Signature), jamais pour les appels sortants. Laisser vide pour desactiver la
# verification de signature en environnement de test.
TWILIO_AUTH_TOKEN=
# Messaging Service unique regroupant SMS + WhatsApp
TWILIO_MESSAGING_SERVICE_SID=

# Content SID des templates WhatsApp approuves (categorie Utility), un par type de message
TWILIO_WHATSAPP_CONTENT_SID_RAPPEL=
TWILIO_WHATSAPP_CONTENT_SID_RELANCE=

# Mode simulation WhatsApp : tant que les templates ne sont pas approuves par Meta,
# laisser a "true" pour tester le flux applicatif sans appeler reellement Twilio WhatsApp.
WHATSAPP_SIMULATION_MODE=true

# Identifiant alphanumerique SMS (max 11 caracteres), fonctionne sans pre-enregistrement pour Orange Cameroun
TWILIO_SMS_SENDER_ID_ORANGE_CM=RENTMGT
# Identifiant alphanumerique SMS pour MTN Cameroun : necessite un pre-enregistrement via
# Twilio Trust Hub (~3 semaines). Laisser vide tant que l'enregistrement n'est pas termine :
# le backend repliera automatiquement sur TWILIO_SMS_LONGCODE_FALLBACK.
TWILIO_SMS_SENDER_ID_MTN_CM=
# Numero long code international Twilio, utilise en repli pour les tests MTN Cameroun
# tant que TWILIO_SMS_SENDER_ID_MTN_CM n'est pas enregistre.
TWILIO_SMS_LONGCODE_FALLBACK=
